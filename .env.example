# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/researchmind

# JWT Authentication
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
